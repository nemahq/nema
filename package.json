{
  "name": "nema",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "VITE_DEV_API_TARGET=https://api-staging.getnema.app pnpm --filter web dev",
    "dev:web:prod": "VITE_DEV_API_TARGET=https://api.getnema.app pnpm --filter web dev:prod",
    "dev:server": "pnpm --filter server dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "depcruise": "depcruise apps/web/src apps/server/src --config .dependency-cruiser.cjs",
    "quality": "turbo run lint && pnpm knip && pnpm depcruise",
    "prepare": "husky",
    "tolgee:push": "tolgee push",
    "supabase:gen-types": "npx -y supabase@2.84.2 gen types --lang=typescript --local > apps/server/src/infra/database.types.ts && prettier --write apps/server/src/infra/database.types.ts"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --cache --cache-strategy content",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write",
    "apps/web/src/lib/tolgee/*.json": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/server/src/infra/i18n/locales/*.json": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tolgee/cli": "^2.16.1",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.1",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript-eslint": "^8.26.0"
  }
}
