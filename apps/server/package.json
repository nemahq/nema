{
  "name": "@nema-io/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload --org $SENTRY_ORG --project nema-server dist",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@nema-io/shared": "workspace:*",
    "@qdrant/js-client-rest": "^1.17.0",
    "@sentry/node": "^10.42.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tolgee/core": "^6.4.0",
    "@trpc/server": "^11.12.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.2.1",
    "neo4j-driver": "^6.0.1",
    "openai": "^6.25.0",
    "voyageai": "^0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nema-io/tsconfig": "workspace:*",
    "@sentry/cli": "^3.3.0",
    "@types/node": "^22.13.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
