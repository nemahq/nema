{
  "name": "@nema-io/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "APP_ENV=local tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@trpc/server": "^11.12.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nema-io/tsconfig": "workspace:*",
    "@types/node": "^22.13.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
