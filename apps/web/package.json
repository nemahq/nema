{
  "name": "@nema-io/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/wait-for-server.mjs && vite --mode staging",
    "dev:local": "node scripts/wait-for-server.mjs && vite --mode local-dev",
    "dev:prod": "node scripts/wait-for-server.mjs && vite --mode production",
    "build": "vite build --mode ${VITE_APP_ENV:-production}",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@nema-io/shared": "workspace:*",
    "@nema-io/weave": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.2",
    "@tolgee/format-icu": "^6.4.0",
    "@tolgee/react": "^6.4.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hotkeys-hook": "^5.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nema-io/server": "workspace:*",
    "@nema-io/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/react": "^16.3.2",
    "@tolgee/web": "^6.4.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "vitest": "^3.1.1"
  }
}
