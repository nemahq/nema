# 공개 config만 여기(repo). 시크릿은 두지 않는다.
# MCP_PUBLIC_URL / SUPABASE_OAUTH_ISSUER는 배포 환경(Railway)에서 실제 값으로 설정한다.

# 이 MCP 서버가 호출할 nema 백엔드(apps/server) tRPC 베이스 URL
NEMA_API_URL=https://api-staging.getnema.app

# 토큰 검증에 쓰는 Supabase 프로젝트(공개 값)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# 배포된 이 서버 자신의 공개 URL. OAuth 보호 자원 식별자. 로컬은 기본값(localhost) 사용.
# MCP_PUBLIC_URL=https://mcp-staging.getnema.app/mcp

# Supabase OAuth 서버 issuer. 미설정 시 SUPABASE_URL에서 파생(/auth/v1).
# SUPABASE_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1

# 로컬 포트
PORT=3002
