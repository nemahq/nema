# APP_ENV=local — 로컬 Supabase(`supabase start`) 전용.
# 아래 키는 Supabase CLI가 로컬 개발용으로 고정 발급하는 기본값으로, 모든 개발자의 로컬 환경에서 동일하다
# (JWT_SECRET이 config.toml에 오버라이드되지 않는 한). 원격에 노출되지 않으므로 시크릿이 아니다 — 커밋 대상.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# staging과 동일한 이유로 분리 — 공유 Qdrant 클러스터를 쓰는 한 로컬 쓰기가 staging/production 데이터와 섞이지 않게 한다.
QDRANT_COLLECTION=statements-local
# 로컬 Docker Qdrant(README "로컬 Qdrant 실행" 절) 전용 — staging/production 공유 클러스터와 무관.
# 인증 없이 띄우므로 QDRANT_API_KEY는 값 검증만 통과하면 되는 더미.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev-dummy-key
