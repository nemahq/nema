{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["estree", "vitest"],
  "ignore": [".claude/**", "legacy/**"],
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": ["vitest.config.base.ts"]
    },
    "apps/server": {
      "project": ["src/**/*.ts"]
    },
    "packages/weave": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
