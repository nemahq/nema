{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["supabase"],
  "ignoreDependencies": ["estree", "vitest"],
  "workspaces": {
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/server": {
      "entry": [
        "src/eval/eval-drafting.ts",
        "src/eval/verify-statement-search.ts",
        "src/eval/statement-engine/seed-data.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["src/infra/**"]
    },
    "packages/shared": {},
    "packages/weave": {
      "entry": [
        "src/index.ts",
        "src/icons.ts",
        "src/styles.css",
        "src/tokens/index.css"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
