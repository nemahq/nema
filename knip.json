{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["estree", "vitest"],
  "workspaces": {
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/server": {
      "entry": ["src/eval/eval-drafting.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/infra/**"]
    },
    "packages/shared": {},
    "packages/weave": {
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
