{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["estree", "vitest"],
  "ignore": [
    ".claude/**",
    "legacy/**",
    "apps/server/src/infra/database.types.ts"
  ],
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": ["vitest.config.base.ts"]
    },
    "apps/server": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mcp": {
      "project": ["src/**/*.ts"]
    },
    "packages/weave": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
