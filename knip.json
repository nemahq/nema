{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["estree", "vitest"],
  "ignore": [
    ".claude/**",
    "legacy/**",
    "apps/server/src/infra/supabase/database.types.ts",
    "apps/web/src/app/error/notFound.ts",
    "apps/web/src/components/layout/LnbSection.tsx",
    "apps/web/src/components/ui/TabbedPanel.tsx",
    "apps/web/src/components/ui/TabbedPanelLayout.tsx",
    "apps/web/src/hooks/useDebouncedValue.ts",
    "apps/web/src/hooks/useIntersectionEffect.ts",
    "apps/web/src/hooks/useTypewriter.ts"
  ],
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": ["vitest.config.base.ts"]
    },
    "apps/server": {
      "entry": ["src/eval/**/run*.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mcp": {
      "project": ["src/**/*.ts"]
    },
    "packages/weave": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
